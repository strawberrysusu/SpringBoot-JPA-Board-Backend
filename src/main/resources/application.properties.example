# [DB 설정 예시]
# 여기에 본인의 DB 설정을 입력하고 파일명을 application.properties로 변경해서 쓰세요.

spring.datasource.url=jdbc:mysql://localhost:3306/jpa_study?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=여기에_비밀번호_입력
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.show_sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect